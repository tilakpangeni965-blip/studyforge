# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# DeepSeek hosted API — SERVER ONLY.
# Keep this out of NEXT_PUBLIC_ variables so it never ships to browsers.
DEEPSEEK_API_KEY=your-deepseek-api-key
# DeepSeek V3.2's old API aliases were retired. Current Flash API supports text and image input.
DEEPSEEK_MODEL=deepseek-flash

# Optional tutor fallback — SERVER ONLY. Called only when the DeepSeek tutor request fails.
# Google Gemini free-tier content may be used to improve Google products; review its data terms.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
